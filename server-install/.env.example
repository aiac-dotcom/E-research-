# Copy to .env in the project root. Keep .env private; never commit it.
# Values use dotenv syntax. Use percent-encoding in database passwords.
NODE_ENV=production
PORT=3000
BASE_PATH=/
DATABASE_URL=postgresql://qa_app:CHANGE_ME@127.0.0.1:5432/qa_dashboard

# ── Authentication (Clerk) ────────────────────────────────────────────────
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY
# Empty uses Clerk directly. Do not enable the Replit-specific proxy.
VITE_CLERK_PROXY_URL=
VITE_API_URL=
# Never set AUTH_MODE=dev in production (the server refuses to start if you do).
AUTH_MODE=clerk

# ── Platform roles ────────────────────────────────────────────────────────
# Comma-separated emails that are always system administrators.
ADMIN_EMAILS=research.admin@unizwa.edu.om
# Staff whose verified email is on these domains get a profile on first sign-in.
# Everyone else must be added by an administrator (People & roles, or CSV import).
ALLOWED_EMAIL_DOMAINS=unizwa.edu.om
CORS_ORIGINS=

# ── Institution (used by harvesting, showcase and OAI-PMH) ────────────────
INSTITUTION_NAME="University of Nizwa"
INSTITUTION_COUNTRY=OM
# ROR ID of the university (look it up at https://ror.org) — ranks local authors first.
INSTITUTION_ROR=
VITE_INSTITUTION_NAME="University of Nizwa"
VITE_PLATFORM_NAME=E-Research
OAI_REPOSITORY_IDENTIFIER=research.unizwa.edu.om
# Contact address sent to OpenAlex / Crossref "polite pool" and shown in OAI-PMH Identify.
HARVEST_CONTACT_EMAIL=research.admin@unizwa.edu.om

# ── Free harvesting sources (keys optional but recommended) ───────────────
# OpenAlex: free key from https://openalex.org (keyless access shares a small daily budget per IP).
OPENALEX_API_KEY=
# ORCID public API client (free): https://info.orcid.org/documentation/features/public-api/
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Semantic Scholar: free key from https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── Subscription sources (enable only if the university subscribes) ───────
# Elsevier Scopus APIs: https://dev.elsevier.com  (InstToken needed off-campus)
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=
SCOPUS_AFFILIATION_ID=
# Clarivate Web of Science Starter API: https://developer.clarivate.com
WOS_API_KEY=

# ── AI ranking analysis (optional service) ────────────────────────────────
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

LOG_LEVEL=info
